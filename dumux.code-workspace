    "settings": {},
    "tasks": {
        "version": "2.0.0",
        "presentation": {
            "echo": true,
            "focus": false,
            "showReuseMessage": true,
            "clear": false,
            "reveal": "always",
            "panel": "dedicated",
        },
        "problemMatcher": [],
        "tasks": [
            {
                "label": "DUMUX 0 configure workspaces",
                "detail": "Collect test lists with python and create .vscode folder",
                "type": "shell",
                "command": "python $(dirname ${workspaceFolder})/workspace-dumux/configure-workspace.py",
                "options": {
                    "cwd": "${fileWorkspaceFolder}"
                }
            },
            {
                "label": "DUMUX 1 dunecontrol to configure",
                "detail": "Calls `dunecontrol` in the dumux installation folder (run in folder above module) to configure and build the module stack",
                "type": "shell",
                "command": "logFile=${workspaceFolder}/.vscode/logs/$(date +\"%Y-%m-%d--%H-%M-%S\")---dunecontrol-configure.log; echo \">\" ./dune-common/bin/dunecontrol --opts=${input:cmakeOpts} ${input:controlModule} all | tee $logFile; echo $logFile; ./dune-common/bin/dunecontrol --opts=${input:cmakeOpts} ${input:controlModule} all 2>&1 | tee -a $logFile; echo $logFile ",
                "options": {
                    "cwd": "${workspaceFolder}/.."
                }
            },
            {
                "label": "DUMUX 2 dunecontrol to clean cache",
                "detail": "Calls `dunecontrol` in the dumux installation folder (run in folder above module) to clean the CMake cache",
                "type": "shell",
                "command": "logFile=${workspaceFolder}/.vscode/logs/$(date +\"%Y-%m-%d--%H-%M-%S\")---dunecontrol-clear.log; echo \">\" ./dune-common/bin/dunecontrol bexec rm -r CMakeFiles CMakeCache.txt | tee $logFile; echo $logFile; ./dune-common/bin/dunecontrol bexec rm -r CMakeFiles CMakeCache.txt 2>&1 | tee -a $logFile; echo $logFile",
                "options": {
                    "cwd": "${workspaceFolder}/.."
                }
            },
            {
                "label": "DUMUX 3 duneproject to create module",
                "detail": "Calls `duneproject` in the dumux installation folder (run in folder above module) to create a new module",
                "type": "shell",
                "command": "./dune-common/bin/duneproject",
                "options": {
                    "cwd": "${workspaceFolder}/.."
                }
            },
            {
                "label": "DUMUX 4 configure cmake",
                "detail": "Reconfigure the module with `cmake build-cmake` (run in module folder)",
                "type": "shell",
                "command": "logFile=${fileWorkspaceFolder}/.vscode/logs/$(date +\"%Y-%m-%d--%H-%M-%S\")---cmake-configure-${input:cmakeBuildType}.log; echo \">\" cmake build-cmake -DCMAKE_BUILD_TYPE=${input:cmakeBuildType} | tee $logFile; echo $logFile; cmake build-cmake -DCMAKE_BUILD_TYPE=${input:cmakeBuildType} 2>&1 | tee -a $logFile; echo $logFile ",
                "options": {
                    "cwd": "${fileWorkspaceFolder}"
                }
            },
            {
                "label": "DUMUX 5 make build_tests",
                "detail": "Make all tests with `make build_tests` (run in `build-cmake` folder)",
                "type": "shell",
                "command": "logFile=${fileWorkspaceFolder}/.vscode/logs/$(date +\"%Y-%m-%d--%H-%M-%S\")---make-build-tests.log; echo \">\" make build_tests | tee $logFile; echo $logFile; make build_tests 2>&1 | tee -a $logFile; echo $logFile",
                "options": {
                    "cwd": "${fileWorkspaceFolder}/build-cmake"
                }
            },
            {
                "label": "DUMUX 6 make specific test",
                "detail": "Make specific test with `make <test-name>` (Run in `build-cmake/{relative-file}` folder)",
                "type": "shell",
                "command": "folder=$(echo '${fileWorkspaceFolder}/build-cmake/${relativeFileDirname}' | tr '\\\\' '/'); cd $folder; logFile=$folder/$(date +\"%Y-%m-%d--%H-%M-%S\")---${input:testCase}-compile.log; echo \">\" make ${input:testCase} | tee $logFile; echo $logFile; make ${input:testCase} 2>&1 | tee -a $logFile; echo $logFile",
                "options": {
                    //     "cwd": "${fileWorkspaceFolder}/build-cmake/${relativeFileDirname}"
                }
            },
            {
                "label": "DUMUX 7 run test",
                "detail": "Run specific test with `<test-name> <param.input>`(Run in `build-cmake/{relative-file}` folder)",
                "type": "shell",
                "command": "folder=$(echo '${fileWorkspaceFolder}/build-cmake/${relativeFileDirname}' | tr '\\\\' '/'); cd $folder; logFile=$folder/$(date +\"%Y-%m-%d--%H-%M-%S\")---${input:testCase}-run.log; echo \">\" ${input:testCase} ${input:paramsFile} ${PN:+-Problem.Name \"$PN\"} | tee $logFile; echo $logFile; ${input:testCase} ${input:paramsFile} ${PN:+-Problem.Name \"$PN\"} 2>&1 | tee -a $logFile; echo $logFile",
                "options": {
                    // "cwd": "${fileWorkspaceFolder}/build-cmake/${relativeFileDirname}",
                    "env": {
                        "PN": "${input:problemName}"
                    }
                }
            },
            {
                "label": "DUMUX 8 Make and Run test",
                "detail": "Compile and Run specific test (Run in `build-cmake/{relative-file}` folder)",
                "dependsOrder": "sequence",
                "dependsOn": [
                    "DUMUX 6 make specific test",
                    "DUMUX 7 run test"
                ]
            },
            {
                "label": "DUMUX 9 Open Results",
                "detail": "Open results in Paraview (Run in `build-cmake/{relative-file}` folder)",
                "type": "shell",
                "command": "folder=$(echo '${fileWorkspaceFolder}/build-cmake/${relativeFileDirname}' | tr '\\\\' '/'); cd $folder; echo $folder; paraview *.pvd; paraview.exe *.pvd",
                "runOptions": {
                    "instanceLimit": 100
                },
                "options": {
                    //     "cwd": "${fileWorkspaceFolder}/build-cmake/${relativeFileDirname}"
                },
                "presentation": {
                    "group": "visualization"
                }
            },
        ]
    }
}